# Appwrite Configuration
# Get these values from your Appwrite console: https://cloud.appwrite.io/console

# Your Appwrite endpoint (usually https://cloud.appwrite.io/v1)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite Project ID
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id_here

# Your Appwrite Database ID
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your_database_id_here

# Your Appwrite Collection ID (for pets collection)
NEXT_PUBLIC_APPWRITE_COLLECTION_ID=your_collection_id_here

# Your Appwrite Found Pets Collection ID (for found pet reports)
NEXT_PUBLIC_APPWRITE_FOUND_PETS_COLLECTION_ID=your_found_pets_collection_id_here
